# 企业融资智能获客系统 - Dev Container
# GitHub Codespaces 自动配置

{
  "name": "financing-acquisition-system",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.14-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "postCreateCommand": "pip install --quiet -r backend/requirements.txt && cd frontend && npm install --silent 2>/dev/null && cd ..",
  "postStartCommand": "echo '启动后端和前端...' && cd backend && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8001 & cd ../frontend && npm run dev -- -p 3000",
  "forwardPorts": [8001, 3000],
  "portsAttributes": {
    "8001": {
      "label": "Backend API",
      "onAutoForward": "openPreview"
    },
    "3000": {
      "label": "Frontend UI",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"],
      "settings": {}
    }
  },
  "remoteUser": "vscode"
}
